# ── Server ────────────────────────────────────────────────────────────────────
PORT=8080

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=algo
POSTGRES_PASSWORD=algo_secret
POSTGRES_DB=algo_visualizer
POSTGRES_DSN=postgres://algo:algo_secret@localhost:5432/algo_visualizer?sslmode=disable

# ── Redis ─────────────────────────────────────────────────────────────────────
# Host-side port is remapped to 6380 in docker-compose.yml to avoid
# colliding with unrelated Redis containers that may already be running on
# port 6379 on this machine. Containers within the compose network always
# use "redis:6379" internally (see docker-compose.yml environment overrides).
REDIS_ADDR=localhost:6380
REDIS_PASSWORD=

# ── Kafka ─────────────────────────────────────────────────────────────────────
# Host-side port is remapped to 29094 for the same reason (avoids colliding
# with unrelated containers already publishing 9092 on this machine).
KAFKA_BROKERS=localhost:29094
KAFKA_JOBS_TOPIC=visualize-jobs
KAFKA_RESULTS_TOPIC=visualize-results

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_RPS=10

# ── Sandbox timeouts ──────────────────────────────────────────────────────────
JOB_TIMEOUT_SECONDS=30
